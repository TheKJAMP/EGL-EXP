#version 450

#extension GL_EXT_shader_8bit_storage : require

// NVN HLE (Vulkan::Nvn::AliasTransferGpu). Moves the bytes two textures of different shapes share
// in a memory pool from one image to the other, the way the memory would: every texel of a piece
// (one level of one layer of a texture, as copied tightly into the scratch buffer) is placed at the
// byte offset its texture's layout gives it in the pool (Switch 2 block-linear GOBs, the same
// addressing as Tegra::Texture::UnswizzleTexture with native tiling, or linear rows), inside a
// window of the pool's bytes.
//   mode 0 (scatter): tightly copied texel bytes -> window.
//   mode 1 (gather):  window -> tightly copied texel bytes (only texels inside the window).
// One invocation per texel; all byte moves are exclusive to their texel, so no atomics.

layout(local_size_x = 16, local_size_y = 8, local_size_z = 1) in;

layout(std430, binding = 0) buffer Memory {
    uint8_t bytes[];
};

layout(std430, binding = 1) buffer MemoryWords {
    uint words[];
};

layout(push_constant) uniform PushConstants {
    uint mode;
    uint tight_offset;  // byte offset of the piece's tight texels in `bytes`
    uint window_offset; // byte offset of the window in `bytes`
    uint window_size;
    int piece_base;     // byte offset of the piece's first byte relative to the window start
    uint cols;
    uint rows;
    uint slices;
    uint bpp;           // bytes per texel
    uint tile_h;        // log2 of the block height in GOBs
    uint tile_d;        // log2 of the block depth in GOBs
    uint pitch;         // linear: bytes per row, 0 = block-linear
} pc;

// GOB offsets of Tegra::Texture (SWIZZLE_X_BITS = 0b100101111, SWIZZLE_Y_BITS = 0b011010000)
// with the Switch 2 adjustment of bits 5 and 6 (NativeGobOffset).
uint BlockLinearOffset(uint xb, uint y, uint z) {
    const uint stride = pc.cols * pc.bpp;
    const uint gobs_in_x = (stride + 63u) >> 6;
    const uint x_shift = 9u + pc.tile_h + pc.tile_d;
    const uint block_size = gobs_in_x << x_shift;
    const uint block_rows = (pc.rows + (1u << (pc.tile_h + 3u)) - 1u) >> (pc.tile_h + 3u);
    const uint slice_size = block_rows * block_size;
    const uint offset_z = (z >> pc.tile_d) * slice_size +
                          ((z & ((1u << pc.tile_d) - 1u)) << (9u + pc.tile_h));
    const uint block_y = y >> 3;
    const uint offset_y = (block_y >> pc.tile_h) * block_size +
                          ((block_y & ((1u << pc.tile_h) - 1u)) << 9u);
    const uint offset_x = (xb >> 6) << x_shift;
    const uint swizzled_x = (xb & 15u) | ((xb & 16u) << 1) | ((xb & 32u) << 3);
    const uint swizzled_y = ((y & 1u) << 4) | ((y & 2u) << 5) | ((y & 4u) << 5);
    uint offset = offset_z + offset_y + offset_x + (swizzled_x | swizzled_y);
    const uint difference = ((offset >> 5) ^ (offset >> 6)) & 1u;
    return offset ^ (difference << 5) ^ (difference << 6);
}

void main() {
    const uint x = gl_GlobalInvocationID.x;
    const uint y = gl_GlobalInvocationID.y;
    const uint z = gl_GlobalInvocationID.z;
    if (x >= pc.cols || y >= pc.rows || z >= pc.slices) {
        return;
    }
    const uint index = (z * pc.rows + y) * pc.cols + x;
    const uint tight = pc.tight_offset + index * pc.bpp;
    // In Switch 2 GOB order, bits 0..3 of BlockLinearOffset(xb, y, z) equal (xb & 15u), and
    // flipping bits 5..6 preserves bits 0..3. Thus for any power-of-two texel size bpp <= 16,
    // x * bpp is aligned to bpp so all bpp bytes of a texel stay contiguous in one 16-byte row.
    if (pc.bpp != 0u && (pc.bpp & (pc.bpp - 1u)) == 0u && pc.bpp <= 16u) {
        const uint base_offset =
            (pc.pitch != 0u) ? (y * pc.pitch + x * pc.bpp) : BlockLinearOffset(x * pc.bpp, y, z);
        const int base_at = pc.piece_base + int(base_offset);
        if (base_at >= 0 && uint(base_at) <= pc.window_size &&
            (pc.window_size - uint(base_at)) >= pc.bpp) {
            const uint window_addr = pc.window_offset + uint(base_at);
            if (pc.bpp >= 4u && ((window_addr | tight) & 3u) == 0u) {
                const uint word_count = pc.bpp >> 2;
                const uint w_idx = window_addr >> 2;
                const uint t_idx = tight >> 2;
                if (pc.mode == 0u) {
                    for (uint w = 0u; w < word_count; ++w) {
                        words[w_idx + w] = words[t_idx + w];
                    }
                } else {
                    for (uint w = 0u; w < word_count; ++w) {
                        words[t_idx + w] = words[w_idx + w];
                    }
                }
            } else {
                if (pc.mode == 0u) {
                    for (uint b = 0u; b < pc.bpp; ++b) {
                        bytes[window_addr + b] = bytes[tight + b];
                    }
                } else {
                    for (uint b = 0u; b < pc.bpp; ++b) {
                        bytes[tight + b] = bytes[window_addr + b];
                    }
                }
            }
            return;
        }
        for (uint b = 0u; b < pc.bpp; ++b) {
            const int at = base_at + int(b);
            if (at < 0 || uint(at) >= pc.window_size) {
                continue;
            }
            const uint window = pc.window_offset + uint(at);
            if (pc.mode == 0u) {
                bytes[window] = bytes[tight + b];
            } else {
                bytes[tight + b] = bytes[window];
            }
        }
        return;
    }
    for (uint b = 0u; b < pc.bpp; ++b) {
        uint offset;
        if (pc.pitch != 0u) {
            offset = y * pc.pitch + x * pc.bpp + b;
        } else {
            offset = BlockLinearOffset(x * pc.bpp + b, y, z);
        }
        const int at = pc.piece_base + int(offset);
        if (at < 0 || uint(at) >= pc.window_size) {
            continue;
        }
        const uint window = pc.window_offset + uint(at);
        if (pc.mode == 0u) {
            bytes[window] = bytes[tight + b];
        } else {
            bytes[tight + b] = bytes[window];
        }
    }
}
